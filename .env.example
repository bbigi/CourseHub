CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

# Database MySQL/MariaDB
# Untuk Vercel, gunakan environment variables di dashboard Vercel.
# Contoh jika ingin pakai nilai default lokal untuk development.
DB_HOST = localhost
DB_PORT = 3306
DB_NAME = coursehub
DB_USER = root
DB_PASS = 
DB_DRIVER = MySQLi
DB_PREFIX = 

# Session storage (Vercel: set SESSION_DRIVER to database or redis if needed)
SESSION_DRIVER = CodeIgniter\\Session\\Handlers\\FileHandler
SESSION_SAVE_PATH = 

# Writable path for readonly container runtimes like Vercel
WRITABLE_PATH = /tmp/coursehub-writable
